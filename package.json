{
  "name": "dash-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dash Ledger - a local-first, mobile-first DoorDash work ledger.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
